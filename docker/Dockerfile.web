# syntax=docker/dockerfile:1.6
#
# AgentForge web image. Multi-stage: build the SPA with Vite, then
# serve the static bundle with nginx.

ARG NODE_VERSION=20

# ---- builder --------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Install deps first for better layer caching.
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund

# Build.
COPY web /app
RUN npm run build

# ---- runtime --------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Drop privileges.
RUN rm /etc/nginx/conf.d/default.conf

# SPA routing: every unknown path falls back to /index.html so React
# Router can take over.
COPY docker/web.nginx.conf /etc/nginx/conf.d/spa.conf

# Static assets.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
